{
      "rules": {
          ".read": false,
              ".write": false,
                  "users": {
                        "$uid": {
                                ".read": "auth != null && auth.uid == $uid",
                                        ".write": "auth != null && auth.uid == $uid && (!data.exists() ? ((newData.child('role').val() == 'admin' && !newData.child('empresaId').exists()) || (newData.hasChildren(['role', 'empresaId', 'convidadoPor']) && root.child('users').child(newData.child('convidadoPor').val()).child('empresaId').val() == newData.child('empresaId').val() && root.child('users').child(newData.child('convidadoPor').val()).child('role').val() == 'admin')) : newData.child('role').val() == data.child('role').val() && ((!data.child('empresaId').exists() && newData.child('empresaId').exists() && root.child('empresas').child(newData.child('empresaId').val()).child('info').child('criadoPor').val() == auth.uid) || (data.child('empresaId').exists() && newData.child('empresaId').val() == data.child('empresaId').val())))"
                                              }
                                                  },
                                                      "empresas": {
                                                            "$empresaId": {
                                                                    "info": {
                                                                              ".read": "auth != null && root.child('users').child(auth.uid).child('empresaId').val() == $empresaId",
                                                                                        ".write": "auth != null && ((!data.exists() && newData.child('criadoPor').val() == auth.uid) || (root.child('users').child(auth.uid).child('empresaId').val() == $empresaId && root.child('users').child(auth.uid).child('role').val() == 'admin'))",
                                                                                                  ".validate": "newData.hasChildren(['nome', 'criadoPor']) && newData.child('criadoPor').isString()"
                                                                                                          },
                                                                                                                  "$collection": {
                                                                                                                            ".read": "auth != null && root.child('users').child(auth.uid).child('empresaId').val() == $empresaId",
                                                                                                                                    ".write": "auth != null && root.child('users').child(auth.uid).child('empresaId').val() == $empresaId && (root.child('users').child(auth.uid).child('role').val() == 'admin' || !($collection == 'contas' || $collection == 'usuarios' || $collection == 'fornecedores'))",
                                                                                                                                                ".indexOn": ["data", "status", "codigo", "cliId", "clienteId", "fornecedorId"]
                                                                                                                                                        }
                                                                                                                                                              }
                                                                                                                                                                  }
                                                                                                                                                                    }
                                                                                                                                                                    }